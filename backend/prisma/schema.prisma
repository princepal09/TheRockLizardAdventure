generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ============ ENUMS ============

enum DifficultyLevel {
  EASY
  MODERATE
  DIFFICULT
  VERY_DIFFICULT
  EXTREME

  @@map("difficulty_level")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("content_status")
}

enum TripType {
  ROAD
  BIKE

  @@map("trip_type")
}

enum ContactStatus {
  READ
  UNREAD

  @@map("contact_status")
}

// ============ AUTH ============

model Admin {
  id                   String    @id @default(uuid()) @db.Char(36)
  name                 String    @db.VarChar(100)
  email                String    @unique @db.VarChar(255)
  passwordHash         String    @map("password_hash") @db.VarChar(255)
  profileImageUrl      String?   @map("profile_image_url") @db.VarChar(1000)
  profileImagePublicId String?   @map("profile_image_public_id") @db.VarChar(255)
  isActive             Boolean   @default(true) @map("is_active")
  lastLoginAt          DateTime? @map("last_login_at") @db.DateTime(0)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  refreshTokens       RefreshToken[]
  resetPasswordTokens ResetPasswordToken[]
  createdTrips        Trip[] @relation("TripCreator")
  createdTreks        Trek[]               @relation("TrekCreator")
  createdExpeditions  Expedition[]         @relation("ExpeditionCreator")

  @@map("admin")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  adminId   String    @map("admin_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.DateTime(0)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt]) // for cleanup job
  @@map("refresh_token")
}

model ResetPasswordToken {
  id        String    @id @default(uuid()) @db.Char(36)
  adminId   String    @map("admin_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.DateTime(0)
  usedAt    DateTime? @map("used_at") @db.DateTime(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("reset_password_token")
}

// ============ LOOKUPS ============

model Region {
  id            String   @id @default(uuid()) @db.Char(36)
  name          String   @db.VarChar(150)
  slug          String   @unique @db.VarChar(180)
  description   String?  @db.Text
  imageUrl      String?  @map("image_url") @db.VarChar(1000)
  imagePublicId String?  @map("image_public_id") @db.VarChar(255)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  trips       Trip[]
  treks       Trek[]
  expeditions Expedition[]

  @@map("region")
}

model Season {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  startMonth  Int?     @map("start_month") @db.UnsignedTinyInt
  endMonth    Int?     @map("end_month") @db.UnsignedTinyInt
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  trips       TripSeason[]
  treks       TrekSeason[]
  expeditions ExpeditionSeason[]

  @@map("season")
}

// ============ TREK ============

model Trek {
  id                 String          @id @default(uuid()) @db.Char(36)
  name               String          @db.VarChar(200)
  slug               String          @unique @db.VarChar(220)
  summary            String?         @db.VarChar(500)
  description        String?         @db.Text
  regionId           String          @map("region_id") @db.Char(36)
  difficulty         DifficultyLevel
  status             ContentStatus   @default(DRAFT)
  durationDays       Int             @map("duration_days")
  distanceKm         Decimal?        @map("distance_km") @db.Decimal(8, 2)
  maxAltitudeMeters  Int?            @map("max_altitude_meters")
  startingPoint      String?         @map("starting_point") @db.VarChar(255)
  endingPoint        String?         @map("ending_point") @db.VarChar(255)
  coverImageUrl      String?         @map("cover_image_url") @db.VarChar(1000)
  coverImagePublicId String?         @map("cover_image_public_id") @db.VarChar(1000)
  price              Decimal?        @db.Decimal(10, 2)
  discountPrice      Decimal?        @map("discount_price") @db.Decimal(10, 2)
  currency           String          @default("INR") @db.Char(3)
  maxGroupSize       Int?            @map("max_group_size")
  minAge             Int?            @map("min_age")
  maxAge             Int?            @map("max_age")
  isFeatured         Boolean         @default(false) @map("is_featured")
  publishedAt        DateTime?       @map("published_at") @db.DateTime(0)
  createdBy          String?         @map("created_by") @db.Char(36)
  createdAt          DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  region      Region          @relation(fields: [regionId], references: [id], onDelete: Restrict)
  creator     Admin?          @relation("TrekCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  seasons     TrekSeason[]
  months      TrekMonth[]
  itineraries TrekItinerary[]
  images      TrekImage[]
  contacts    Contact[]

  @@index([regionId, status]) // region listing page (also covers the FK)
  @@index([status, isFeatured]) // homepage featured
  @@index([status, publishedAt]) // latest published
  @@index([difficulty]) // filter
  @@index([createdBy])
  @@map("trek")
  departureDates String? @map("departure_dates") @db.Text
  meetingPoint String? @map("meeting_point") @db.Text
  inclusions String? @map("inclusions") @db.Text
  exclusions String? @map("exclusions") @db.Text
  requiredGear String? @map("required_gear") @db.Text
  cancellationPolicy String? @map("cancellation_policy") @db.Text
  refundPolicy String? @map("refund_policy") @db.Text

}

model TrekSeason {
  trekId   String @map("trek_id") @db.Char(36)
  seasonId String @map("season_id") @db.Char(36)

  trek   Trek   @relation(fields: [trekId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@id([trekId, seasonId])
  @@index([seasonId])
  @@map("trek_season")
}

model TrekMonth {
  trekId String @map("trek_id") @db.Char(36)
  month  Int    @db.UnsignedTinyInt // 1-12

  trek Trek @relation(fields: [trekId], references: [id], onDelete: Cascade)

  @@id([trekId, month])
  @@index([month])
  @@map("trek_month")
}

model TrekItinerary {
  id             String   @id @default(uuid()) @db.Char(36)
  trekId         String   @map("trek_id") @db.Char(36)
  dayNumber      Int      @map("day_number")
  title          String   @db.VarChar(255)
  description    String?  @db.Text
  distanceKm     Decimal? @map("distance_km") @db.Decimal(8, 2)
  altitudeMeters Int?     @map("altitude_meters")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  trek Trek @relation(fields: [trekId], references: [id], onDelete: Cascade)

  @@unique([trekId, dayNumber])
  @@map("trek_itinerary")
}

model TrekImage {
  id            String   @id @default(uuid()) @db.Char(36)
  trekId        String   @map("trek_id") @db.Char(36)
  imageUrl      String   @map("image_url") @db.VarChar(1000)
  imagePublicId String?  @map("image_public_id") @db.VarChar(1000)
  altText       String?  @map("alt_text") @db.VarChar(255)
  caption       String?  @db.VarChar(255)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)

  trek Trek @relation(fields: [trekId], references: [id], onDelete: Cascade)

  @@index([trekId, sortOrder])
  @@map("trek_image")
}

// ============ EXPEDITION ============

model Expedition {
  id                 String          @id @default(uuid()) @db.Char(36)
  name               String          @db.VarChar(200)
  slug               String          @unique @db.VarChar(220)
  summary            String?         @db.VarChar(500)
  description        String?         @db.Text
  regionId           String          @map("region_id") @db.Char(36)
  difficulty         DifficultyLevel
  status             ContentStatus   @default(DRAFT)
  durationDays       Int             @map("duration_days")
  distanceKm         Decimal?        @map("distance_km") @db.Decimal(8, 2)
  maxAltitudeMeters  Int?            @map("max_altitude_meters")
  startingPoint      String?         @map("starting_point") @db.VarChar(255)
  endingPoint        String?         @map("ending_point") @db.VarChar(255)
  coverImageUrl      String?         @map("cover_image_url") @db.VarChar(1000)
  coverImagePublicId String?         @map("cover_image_public_id") @db.VarChar(1000)

  price         Decimal?  @db.Decimal(10, 2)
  discountPrice Decimal?  @map("discount_price") @db.Decimal(10, 2)
  currency      String    @default("INR") @db.Char(3)
  maxGroupSize  Int?      @map("max_group_size")
  minAge        Int?      @map("min_age")
  maxAge        Int?      @map("max_age")
  isFeatured    Boolean   @default(false) @map("is_featured")
  publishedAt   DateTime? @map("published_at") @db.DateTime(0)
  createdBy     String?   @map("created_by") @db.Char(36)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  region      Region                @relation(fields: [regionId], references: [id], onDelete: Restrict)
  creator     Admin?                @relation("ExpeditionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  seasons     ExpeditionSeason[]
  itineraries ExpeditionItinerary[]
  images      ExpeditionImage[]
  contacts    Contact[]

  @@index([regionId, status])
  @@index([status, isFeatured])
  @@index([status, publishedAt])
  @@index([difficulty])
  @@index([createdBy])
  @@map("expedition")
  departureDates String? @map("departure_dates") @db.Text
  meetingPoint String? @map("meeting_point") @db.Text
  inclusions String? @map("inclusions") @db.Text
  exclusions String? @map("exclusions") @db.Text
  requiredGear String? @map("required_gear") @db.Text
  cancellationPolicy String? @map("cancellation_policy") @db.Text
  refundPolicy String? @map("refund_policy") @db.Text

}

model ExpeditionSeason {
  expeditionId String @map("expedition_id") @db.Char(36)
  seasonId     String @map("season_id") @db.Char(36)

  expedition Expedition @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  season     Season     @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@id([expeditionId, seasonId])
  @@index([seasonId])
  @@map("expedition_season")
}

model ExpeditionItinerary {
  id             String   @id @default(uuid()) @db.Char(36)
  expeditionId   String   @map("expedition_id") @db.Char(36)
  dayNumber      Int      @map("day_number")
  title          String   @db.VarChar(255)
  description    String?  @db.Text
  distanceKm     Decimal? @map("distance_km") @db.Decimal(8, 2)
  altitudeMeters Int?     @map("altitude_meters")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  expedition Expedition @relation(fields: [expeditionId], references: [id], onDelete: Cascade)

  @@unique([expeditionId, dayNumber])
  @@map("expedition_itinerary")
}

model ExpeditionImage {
  id            String   @id @default(uuid()) @db.Char(36)
  expeditionId  String   @map("expedition_id") @db.Char(36)
  imageUrl      String   @map("image_url") @db.VarChar(1000)
  imagePublicId String   @map("image_public_id") @db.VarChar(1000)
  altText       String?  @map("alt_text") @db.VarChar(255)
  caption       String?  @db.VarChar(255)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)

  expedition Expedition @relation(fields: [expeditionId], references: [id], onDelete: Cascade)

  @@index([expeditionId, sortOrder])
  @@map("expedition_image")
}

// ============ ROAD / BIKE TRIPS ============

model Trip {
  id                 String          @id @default(uuid()) @db.Char(36)
  tripType           TripType @map("trip_type")
  vehicleDetails     String? @map("vehicle_details") @db.Text
  name               String          @db.VarChar(200)
  slug               String          @unique @db.VarChar(220)
  summary            String?         @db.VarChar(500)
  description        String?         @db.Text
  regionId           String          @map("region_id") @db.Char(36)
  difficulty         DifficultyLevel
  status             ContentStatus   @default(DRAFT)
  durationDays       Int             @map("duration_days")
  distanceKm         Decimal?        @map("distance_km") @db.Decimal(8, 2)
  maxAltitudeMeters  Int?            @map("max_altitude_meters")
  startingPoint      String?         @map("starting_point") @db.VarChar(255)
  endingPoint        String?         @map("ending_point") @db.VarChar(255)
  coverImageUrl      String?         @map("cover_image_url") @db.VarChar(1000)
  coverImagePublicId String?         @map("cover_image_public_id") @db.VarChar(1000)

  price         Decimal?  @db.Decimal(10, 2)
  discountPrice Decimal?  @map("discount_price") @db.Decimal(10, 2)
  currency      String    @default("INR") @db.Char(3)
  maxGroupSize  Int?      @map("max_group_size")
  minAge        Int?      @map("min_age")
  maxAge        Int?      @map("max_age")
  isFeatured    Boolean   @default(false) @map("is_featured")
  publishedAt   DateTime? @map("published_at") @db.DateTime(0)
  createdBy     String?   @map("created_by") @db.Char(36)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  region      Region                @relation(fields: [regionId], references: [id], onDelete: Restrict)
  creator     Admin?                @relation("TripCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  seasons     TripSeason[]
  itineraries TripItinerary[]
  images      TripImage[]
  contacts    Contact[]

  @@index([regionId, status])
  @@index([status, isFeatured])
  @@index([status, publishedAt])
  @@index([difficulty])
  @@index([status, tripType])
  @@index([createdBy])
  @@map("trip")
  departureDates String? @map("departure_dates") @db.Text
  meetingPoint String? @map("meeting_point") @db.Text
  inclusions String? @map("inclusions") @db.Text
  exclusions String? @map("exclusions") @db.Text
  requiredGear String? @map("required_gear") @db.Text
  cancellationPolicy String? @map("cancellation_policy") @db.Text
  refundPolicy String? @map("refund_policy") @db.Text

}

model TripSeason {
  tripId String @map("trip_id") @db.Char(36)
  seasonId     String @map("season_id") @db.Char(36)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  season     Season     @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@id([tripId, seasonId])
  @@index([seasonId])
  @@map("trip_season")
}

model TripItinerary {
  id             String   @id @default(uuid()) @db.Char(36)
  tripId   String   @map("trip_id") @db.Char(36)
  dayNumber      Int      @map("day_number")
  title          String   @db.VarChar(255)
  description    String?  @db.Text
  distanceKm     Decimal? @map("distance_km") @db.Decimal(8, 2)
  altitudeMeters Int?     @map("altitude_meters")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, dayNumber])
  @@map("trip_itinerary")
}

model TripImage {
  id            String   @id @default(uuid()) @db.Char(36)
  tripId  String   @map("trip_id") @db.Char(36)
  imageUrl      String   @map("image_url") @db.VarChar(1000)
  imagePublicId String   @map("image_public_id") @db.VarChar(1000)
  altText       String?  @map("alt_text") @db.VarChar(255)
  caption       String?  @db.VarChar(255)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, sortOrder])
  @@map("trip_image")
}

// ============ GALLERY / CONTACT / SETTINGS ============

model Gallery {
  id            String   @id @default(uuid()) @db.Char(36)
  imageUrl      String   @map("image_url") @db.VarChar(1000)
  imagePublicId String   @map("image_public_id") @db.VarChar(1000)
  altText       String?  @map("alt_text") @db.VarChar(255)
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([isActive, sortOrder])
  @@map("gallery")
}

model Contact {
  id           String        @id @default(uuid()) @db.Char(36)
  name         String        @db.VarChar(150)
  email        String        @db.VarChar(255)
  phone        String?       @db.VarChar(30)
  subject      String?       @db.VarChar(255)
  message      String        @db.Text
  tripId       String?       @map("trip_id") @db.Char(36)
  trekId       String?       @map("trek_id") @db.Char(36)
  expeditionId String?       @map("expedition_id") @db.Char(36)
  status       ContactStatus @default(UNREAD)
  adminNotes   String?       @map("admin_notes") @db.Text
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  trip       Trip?       @relation(fields: [tripId], references: [id], onDelete: SetNull)
  trek       Trek?       @relation(fields: [trekId], references: [id], onDelete: SetNull)
  expedition Expedition? @relation(fields: [expeditionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt]) // admin inbox
  @@index([email])
  @@index([trekId])
  @@index([expeditionId])
  @@map("contact")
}

model SiteSettings {
  id                String   @id @default(uuid()) @db.Char(36)
  logoUrl           String?  @map("logo_url") @db.VarChar(1000)
  logoPublicId      String?  @map("logo_public_id") @db.VarChar(1000)
  heroImageUrl      String?  @map("hero_image_url") @db.VarChar(1000)
  heroImagePublicId String?  @map("hero_image_public_id") @db.VarChar(1000)
  contactEmail      String?  @map("contact_email") @db.VarChar(255)
  contactPhone      String?  @map("contact_phone") @db.VarChar(30)
  whatsappPhone     String?  @map("whatsapp_phone") @db.VarChar(30)
  address           String?  @db.Text
  facebookUrl       String?  @map("facebook_url") @db.VarChar(500)
  instagramUrl      String?  @map("instagram_url") @db.VarChar(500)
  youtubeUrl        String?  @map("youtube_url") @db.VarChar(500)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("site_settings")
}

model TeamMember {
  id             String   @id @default(uuid()) @db.Char(36)
  name           String   @db.VarChar(150)
  role           String   @db.VarChar(100)
  bio            String?  @db.Text
  qualifications String?  @db.Text
  photoUrl       String?  @map("photo_url") @db.VarChar(1000)
  photoPublicId  String?  @map("photo_public_id") @db.VarChar(1000)
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(false) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@index([isActive, sortOrder])
  @@map("team_members")
}
